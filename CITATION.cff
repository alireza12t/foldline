    given-names: "Alireza"
version: "1.0.0"
date-released: "2026-11-06"
license: PolyForm-Noncommercial-1.0.0
repository-code: "https://github.com/alireza12t/foldline"
url: "https://alireza12t.github.io/foldline/"
keywords:
  - html-to-video
  - canvas-to-video
  - webcodecs
  - h264
  - video-rendering
  - programmatic-video
  - headless-chrome
  - macos
references:

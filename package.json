{
  "name": "foldline-mcp",
  "version": "1.2.0",
  "mcpName": "io.github.alireza12t/foldline",
  "type": "module",
  "description": "Foldline: render HTML canvas animations to MP4 fast on a Mac (WebCodecs hardware H.264 in headless Chrome), with an MCP server for coding agents and 66 code-made film styles.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "html-to-video",
    "canvas-to-video",
    "canvas-to-mp4",
    "webcodecs",
    "h264",
    "mp4",
    "video-rendering",
    "programmatic-video",
    "headless-chrome",
    "playwright",
    "videotoolbox",
    "hardware-encoding",
    "apple-silicon",
    "macos",
    "animation",
    "motion-graphics",
    "creative-coding",
    "claude-code",
    "lemo-opuscar"
  ],
  "homepage": "https://alireza12t.github.io/foldline/",
  "author": "Alireza Toghiani",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alireza12t/foldline.git"
  },
  "bin": {
    "foldline-mcp": "core/mcp/server.mjs"
  },
  "files": [
    "core/",
    "styles/README.md",
    "styles/*/STYLE.md",
    "styles/*/DEMO.md",
    "styles/*/style.json",
    "AGENTS.md",
    "DIRECTOR.md",
    "TECHNIQUE.md",
    "MY-STYLES.md",
    "LEMO-README.md",
    "NOTICE.md",
    "LICENSE",
    "licenses/",
    "llms.txt",
    "llms-full.txt",
    "requirements*.txt",
    "plugin/skills/lemo-opuscar/scripts/",
    "tools/fetch.sh",
    "tools/assets.json"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright-core": "1.63.0",
    "three": "0.170.0",
    "zod": "^4.6.7"
  }
}
